# Fetched data — ignored except the accumulated daily history, which IS
# tracked so day-of-week consumption patterns can be built over time.
# NOTE: must be "data/*" (contents), not "data/" (the directory) — git
# cannot re-include a file whose parent directory itself is excluded.
data/*
!data/history.ndjson

# Generated build output — regenerated by build_dashboard.py from data/
public/

# Python
__pycache__/
*.pyc

# Secrets
.env
.pinergy.env

# Legacy one-off dashboard superseded by template.html + build_dashboard.py
dashboard.html
